# ---------------------------------------------------------------------------
# Nayaro Food Delivery — API configuration
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Browser origins allowed to call the API with credentials (comma separated)
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
APP_PUBLIC_URL=http://localhost:3000

# --- MySQL ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nayaro
DB_PASSWORD=change-me
DB_NAME=nayaro_food_delivery
DB_CONNECTION_LIMIT=10

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-xxxxxx
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-random-string-xx
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_DAYS_REMEMBER=30
# COOKIE_DOMAIN=.nayaro.tech
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# --- WhatsApp ------------------------------------------------------------
# log   -> writes messages to the server log (development only)
# meta  -> WhatsApp Cloud API
# twilio-> Twilio WhatsApp
# Off until the WhatsApp integration ships (orders still arrive live + by push)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=log
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_API_VERSION=v21.0
# WHATSAPP_TWILIO_ACCOUNT_SID=
# WHATSAPP_TWILIO_AUTH_TOKEN=
# WHATSAPP_TWILIO_FROM=whatsapp:+14155238886

# --- Email ----------------------------------------------------------------
# log    -> prints emails (and codes) to the server log (development only)
# resend -> sends through https://resend.com (needs RESEND_API_KEY and a verified domain)
EMAIL_PROVIDER=log
# RESEND_API_KEY=re_...
# EMAIL_FROM="Nayaro Food <no-reply@yourdomain.com>"

# --- OTP -----------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Uploads -------------------------------------------------------------
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=3145728

# --- Misc ----------------------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- Web Push (VAPID) ---------------------------------------------------
# Generate with: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@nayaro.tech
