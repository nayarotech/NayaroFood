# =============================================================================
# Nayaro Food API — PRODUCTION settings
# Fill in every value marked  <-- CHANGE  before starting the app.
# The JWT and VAPID keys below were freshly generated for this build. Keep this
# file private. Never reuse your local development .env values here.
# =============================================================================

NODE_ENV=production
# cPanel/Passenger assigns the port itself; this is only a fallback.
PORT=3000
LOG_LEVEL=info

# --- Domains -----------------------------------------------------------------
# Your Vercel site (frontend). Several allowed: comma separated, no trailing /.
CORS_ORIGINS=https://food-delivery.nayaro.tech   # <-- CHANGE
# This API's own public address (the cPanel Node app URL).
API_PUBLIC_URL=https://api.food-delivery.nayaro.tech   # <-- CHANGE
APP_PUBLIC_URL=https://food-delivery.nayaro.tech   # <-- CHANGE

# --- Cookies -----------------------------------------------------------------
# The frontend and the API must share a parent domain (e.g. .nayaro.tech) so
# the sign-in cookie reaches both. Leading dot included.
COOKIE_DOMAIN=.nayaro.tech   # <-- CHANGE
COOKIE_SECURE=true

# --- MySQL (cPanel → MySQL Databases) ----------------------------------------
# If a password contains # or spaces, wrap it in double quotes: DB_PASSWORD="p#ss word"
DB_HOST=localhost
DB_PORT=3306
DB_USER=cpaneluser_nayaro   # <-- CHANGE
DB_PASSWORD=   # <-- CHANGE
DB_NAME=cpaneluser_food   # <-- CHANGE
DB_CONNECTION_LIMIT=10

# --- Auth (freshly generated — keep secret) -----------------------------------
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_TTL_DAYS_REMEMBER=30
BCRYPT_ROUNDS=12

# --- Web Push (freshly generated) --------------------------------------------
VAPID_PUBLIC_KEY=__VAPID_PUBLIC_KEY__
VAPID_PRIVATE_KEY=__VAPID_PRIVATE_KEY__
VAPID_SUBJECT=mailto:support@nayaro.tech

# --- WhatsApp (off until the integration ships) -------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=log

# --- Uploads (stored in ./uploads next to server.js) --------------------------
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=3145728

# --- Misc ----------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Behind Cloudflare? Set to cf-connecting-ip so rate limits are per visitor.
# Leave empty if the API is reachable directly (not only through Cloudflare).
CLIENT_IP_HEADER=
PLATFORM_UTC_OFFSET=+05:45

# --- First Super Admin (used once by `npm run create-admin`) -----------------
# Fill these, run the script, then DELETE the ADMIN_PASSWORD line.
ADMIN_EMAIL=admin@nayaro.tech   # <-- CHANGE
ADMIN_NAME=Nayaro Tech Admin
ADMIN_PASSWORD=   # <-- CHANGE (10+ characters)
